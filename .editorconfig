# Line endings are handled by .gitattributes: LF in the repository, the platform default on checkout.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,gradle,json}]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
